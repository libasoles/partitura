---
import '@fontsource-variable/montserrat';
import '../styles/global.css';
import '../styles/editor.css';
import '../styles/debugger.css';
import EditorSection from '../components/EditorSection.astro';
import { renderEmptyStaff } from '../lib/staff.js';

// Página interna: el editor real (el mismo componente y script que el sitio) y, debajo, el panel de at / forward.
const staff = await renderEmptyStaff(undefined, undefined, { grandStaff: true });
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    <title>Debugger · Partitura</title>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  </head>
  <body class="debug-page">
    <header class="debug-bar">
      <h1>Debugger</h1>
      <p>Página interna: es el editor real de Partitura (cada pestaña es un caso, con partituras guardadas aparte de las del sitio). Abajo, para la partitura abierta, se ve dónde queda cada figura según <code>at</code> y según <code>forward</code>.</p>
    </header>

    <main class="score-page" id="top">
      <EditorSection locale="es" staff={staff} />
    </main>

    <section class="debug-panel" aria-label="Debug de la partitura abierta">
      <h2>Compases de «<span id="debugTitle"></span>»</h2>
      <div id="debugMeasures" class="debug-measures"></div>
      <details class="case-json">
        <summary>JSON de la partitura (editable; pasa por <code>sanitize</code> como cualquier partitura guardada)</summary>
        <textarea id="debugJson" class="json" rows="12" spellcheck="false"></textarea>
        <p id="debugJsonError" class="json-error" hidden></p>
        <button type="button" id="debugApply">Aplicar</button>
      </details>
    </section>

    <script>
      import '../client/debugger.js';
    </script>
  </body>
</html>
