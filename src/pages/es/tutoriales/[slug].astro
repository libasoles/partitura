---
import TutorialsPage from '../../../components/TutorialsPage.astro';
import { slugs } from '../../../lib/tutorials';

export const getStaticPaths = () => slugs.map((slug) => ({ params: { slug } }));
const { slug } = Astro.params;
---

<TutorialsPage locale="es" slug={slug as (typeof slugs)[number]} />
