---
import '@fontsource-variable/montserrat';
import '../styles/global.css';
import latinFont from '@fontsource-variable/montserrat/files/montserrat-latin-wght-normal.woff2?url';
import { locales, ogLocales, pathFor, rootPath, strings, termsPath, tutorialsPath, type Locale } from '../i18n';
import { pageJsonLd } from '../lib/jsonld';

interface Props {
  locale: Locale;
  title: string;
  description: string;
  /** The same page in each language, as paths; drives canonical and hreflang. */
  paths: Record<Locale, string>;
  faq?: { q: string; a: string }[];
  /** The editor page: its menu also loads and exports scores. */
  editor?: boolean;
}

const { locale, title, description, paths, faq, editor = false } = Astro.props;
const s = strings(locale);
const site = Astro.site!;
const abs = (l: Locale) => new URL(paths[l], site).toString();
const canonical = abs(locale);
const ogImage = new URL('/og.png', site).toString();
const homeUrl = new URL(rootPath, site).toString();
const jsonLd = pageJsonLd({
  locale,
  siteName: s.ui.siteName,
  name: title,
  description,
  url: canonical,
  homeUrl,
  faq,
});
---

<!doctype html>
<html lang={s.htmlLang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {locales.map((l) => <link rel="alternate" hreflang={l} href={abs(l)} />)}
    <link rel="alternate" hreflang="x-default" href={homeUrl} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={s.ui.siteName} />
    <meta property="og:locale" content={ogLocales[locale]} />
    {locales.filter((l) => l !== locale).map((l) => <meta property="og:locale:alternate" content={ogLocales[l]} />)}
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={s.ui.ogImageAlt} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image" content={ogImage} />
    <meta name="twitter:image:alt" content={s.ui.ogImageAlt} />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="theme-color" content="#ffffff" />
    <link rel="preload" href={latinFont} as="font" type="font/woff2" crossorigin />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/manifest.webmanifest" />
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd).replace(/</g, '\\u003c')} />
  </head>
  <body class="score-body">
        <header class={editor ? 'site-header site-header--editor' : 'site-header'}>
      <a class="brand" href={pathFor(locale)} aria-label={`${s.ui.siteName} — ${s.ui.home}`}>
        <svg class="brand-mark" viewBox="20 -245 800 1035" fill="currentColor" aria-hidden="true"><g transform="translate(-43 -87)"><g transform="translate(229 687) rotate(12) scale(0.88 1.14) translate(-229 -687)"><path d="M207 597 C172 556 152 525 143 473 L167 492 C119 447 109 387 120 326 L145 354 C128 262 146 178 196 119 C232 75 285 43 340 25 C356 21 362 28 359 46 C354 93 342 144 336 173 L312 214 L345 185 C370 265 381 336 368 397 C361 430 347 452 323 478 L359 450 C353 494 330 528 306 556 L339 535 C319 574 287 601 259 624 C240 644 231 664 229 687 C218 652 213 620 207 597Z"/><path d="M229 687 C195 536 201 375 255 208 C221 395 223 553 238 619 C233 648 230 671 229 687Z" style="fill: var(--paper)"/></g></g><path transform="translate(-8 0)" d="M229 687 L389 573 C485 493 583 458 679 498 C600 474 518 492 398 585 L229 698Z"/><ellipse cx="168" cy="657" rx="69.6" ry="30.9" transform="rotate(35 168 657)"/></svg>
      </a>
      <div class="site-menu" id="siteMenu">
        <button id="siteMenuToggle" class="menu-toggle" type="button" aria-label={s.ui.menu} aria-haspopup="true" aria-expanded="false" aria-controls="siteMenuList">
          <svg viewBox="0 0 24 24" width="24" height="24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M4 6h16M4 12h16M4 18h16" /></svg>
        </button>
        <ul id="siteMenuList" class="menu-list" role="menu" hidden>
          <li role="none"><a role="menuitem" href={tutorialsPath(locale)}><svg class="menu-icon" viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 7v14"/><path d="M3 18a1 1 0 0 1-1-1V4a1 1 0 0 1 1-1h5a4 4 0 0 1 4 4 4 4 0 0 1 4-4h5a1 1 0 0 1 1 1v13a1 1 0 0 1-1 1h-6a3 3 0 0 0-3 3 3 3 0 0 0-3-3z"/></svg>{s.ui.navTutorials}</a></li>
          {editor && (
            <>
              <li role="none"><button role="menuitem" type="button" id="menuLoad"><svg class="menu-icon" viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 3v12"/><path d="m17 8-5-5-5 5"/><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/></svg>{s.ui.menuLoad}</button></li>
              <li role="none" class="menu-group">
                <button role="menuitem" type="button" class="menu-group-label" id="menuExportLabel" data-submenu-toggle aria-expanded="false" aria-controls="menuExportList"><svg class="menu-icon" viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 15V3"/><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><path d="m7 10 5 5 5-5"/></svg>{s.ui.menuExport}<svg class="menu-chevron" viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m6 9 6 6 6-6"/></svg></button>
                <ul role="group" aria-labelledby="menuExportLabel" class="menu-sublist" id="menuExportList" hidden>
                  <li role="none"><button role="menuitem" type="button" id="menuExportPdf"><svg class="menu-icon" viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M15 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V7Z"/><path d="M14 2v4a2 2 0 0 0 2 2h4"/><path d="M10 9H8"/><path d="M16 13H8"/><path d="M16 17H8"/></svg>{s.ui.menuExportPdf}</button></li>
                  <li role="none"><button role="menuitem" type="button" id="menuExportXml"><svg class="menu-icon" viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M15 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V7Z"/><path d="M14 2v4a2 2 0 0 0 2 2h4"/><path d="m10 13-2 2 2 2"/><path d="m14 17 2-2-2-2"/></svg>{s.ui.menuExportXml}</button></li>
                  <li role="none"><button role="menuitem" type="button" id="menuExportMidi"><svg class="menu-icon" viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M15 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V7Z"/><path d="M14 2v4a2 2 0 0 0 2 2h4"/><path d="M9 18v-6l5-1v6"/><circle cx="7.5" cy="18" r="1.5"/><circle cx="12.5" cy="17" r="1.5"/></svg>{s.ui.menuExportMidi}</button></li>
                </ul>
              </li>
            </>
          )}
        </ul>
        {editor && <input id="menuFile" type="file" accept=".musicxml,.xml,.mid,.midi,audio/midi,application/xml,text/xml" hidden />}
      </div>
    </header>
    <slot />
    <button type="button" class="beta-badge" id="betaOpen" aria-expanded="false" aria-controls="betaPopover">{s.ui.betaLabel}</button>
    <div class="beta-popover" id="betaPopover" role="region" aria-label={s.ui.betaLabel} hidden>
      <p>{s.ui.betaP1}</p>
      <p>{s.ui.betaP2}</p>
      <p>{s.ui.betaP3}</p>
      <p>{s.ui.betaP4}</p>
    </div>
    <footer class="site-footer">
      <a href={termsPath(locale)}>{s.ui.footerTerms}</a>
    </footer>
    <script is:inline>
      (function () {
        var betaOpen = document.getElementById('betaOpen');
        var betaPop = document.getElementById('betaPopover');
        function setBeta(open) {
          betaPop.hidden = !open;
          betaOpen.setAttribute('aria-expanded', String(open));
        }
        betaOpen.addEventListener('click', function () { setBeta(betaPop.hidden); });
        document.addEventListener('click', function (event) {
          if (!betaPop.hidden && !betaPop.contains(event.target) && !betaOpen.contains(event.target)) setBeta(false);
        });
        document.addEventListener('keydown', function (event) {
          if (event.key === 'Escape' && !betaPop.hidden) { setBeta(false); betaOpen.focus(); }
        });
      })();
      (function () {
        var toggle = document.getElementById('siteMenuToggle');
        var list = document.getElementById('siteMenuList');
        var box = document.getElementById('siteMenu');
        var sub = document.querySelector('[data-submenu-toggle]');
        function setSub(open) {
          if (!sub) return;
          sub.setAttribute('aria-expanded', String(open));
          document.getElementById(sub.getAttribute('aria-controls')).hidden = !open;
        }
        function close(focus) {
          setSub(false);
          list.hidden = true;
          toggle.setAttribute('aria-expanded', 'false');
          if (focus) toggle.focus();
        }
        toggle.addEventListener('click', function () {
          list.hidden = !list.hidden;
          toggle.setAttribute('aria-expanded', String(!list.hidden));
          if (!list.hidden) list.querySelector('[role=menuitem]').focus();
        });
        document.addEventListener('click', function (event) {
          if (!box.contains(event.target)) close(false);
          else if (event.target.closest('[data-submenu-toggle]')) setSub(sub.getAttribute('aria-expanded') !== 'true');
          else if (event.target.closest('[role=menuitem]')) close(false);
        });
        box.addEventListener('keydown', function (event) {
          if (event.key === 'Escape' && !list.hidden) { event.preventDefault(); close(true); return; }
          if (event.key !== 'ArrowDown' && event.key !== 'ArrowUp') return;
          var items = Array.prototype.slice.call(list.querySelectorAll('[role=menuitem]')).filter(function (el) { return !el.closest('[hidden]'); });
          var at = items.indexOf(document.activeElement);
          if (list.hidden) return;
          event.preventDefault();
          items[(at + (event.key === 'ArrowDown' ? 1 : items.length - 1)) % items.length].focus();
        });
      })();
    </script>
  </body>
</html>
