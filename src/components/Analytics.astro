---
// Google Analytics 4 (gtag.js): se incluye en el <head> de cada layout/página. Una página nueva debe usar Base.astro (o este componente).
const GA_ID = 'G-YX99KJ1Q99';
---
<script is:inline async src={`https://www.googletagmanager.com/gtag/js?id=${GA_ID}`}></script>
<script is:inline define:vars={{ GA_ID }}>
  window.dataLayer = window.dataLayer || [];
  function gtag() { dataLayer.push(arguments); }
  gtag('js', new Date());
  gtag('config', GA_ID);
</script>
