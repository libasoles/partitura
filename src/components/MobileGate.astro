---
import { tutorialsPath, type Locale, strings } from '../i18n';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const s = strings(locale);
const g = s.mobileGate;
// Lucide icons (stroke 2, 24 grid), one per feature. Keys are quoted: the Astro compiler reads a bare `export:` as a statement.
const icons: Record<string, string> = {
  'notes': '<path d="M9 18V5l12-2v13"/><circle cx="6" cy="18" r="3"/><circle cx="18" cy="16" r="3"/>',
  'tab': '<path d="M4 6h16M4 10h16M4 14h16M4 18h16"/>',
  'export': '<path d="M12 15V3"/><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><path d="m7 10 5 5 5-5"/>',
  'save': '<path d="M15.2 3a2 2 0 0 1 1.4.6l3.8 3.8a2 2 0 0 1 .6 1.4V19a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2z"/><path d="M17 21v-7a1 1 0 0 0-1-1H8a1 1 0 0 0-1 1v7"/><path d="M7 3v4a1 1 0 0 0 1 1h7"/>',
};
---

<section class="mobile-gate" aria-labelledby="mobileGateTitle">
  <div class="mobile-gate__hero">
    <svg class="mobile-gate__logo" viewBox="20 -245 800 1035" fill="currentColor" aria-hidden="true"><g transform="translate(-43 -87)"><g transform="translate(229 687) rotate(12) scale(0.88 1.14) translate(-229 -687)"><path d="M207 597 C172 556 152 525 143 473 L167 492 C119 447 109 387 120 326 L145 354 C128 262 146 178 196 119 C232 75 285 43 340 25 C356 21 362 28 359 46 C354 93 342 144 336 173 L312 214 L345 185 C370 265 381 336 368 397 C361 430 347 452 323 478 L359 450 C353 494 330 528 306 556 L339 535 C319 574 287 601 259 624 C240 644 231 664 229 687 C218 652 213 620 207 597Z"/><path d="M229 687 C195 536 201 375 255 208 C221 395 223 553 238 619 C233 648 230 671 229 687Z" style="fill: var(--paper)"/></g></g><path transform="translate(-8 0)" d="M229 687 L389 573 C485 493 583 458 679 498 C600 474 518 492 398 585 L229 698Z"/><ellipse cx="180" cy="657" rx="60.5" ry="26.9" transform="rotate(35 180 657)"/></svg>
    <p class="mobile-gate__name">{s.ui.siteName}</p>
    <h2 id="mobileGateTitle">{g.title}</h2>
    <p class="mobile-gate__lead">{g.body}</p>
    <a class="mobile-gate__cta" href={tutorialsPath(locale)}>{g.tutorials}</a>
    <p class="mobile-gate__hint" aria-hidden="true">{g.scroll}</p>
  </div>

  <div class="mobile-gate__features">
    <h2>{s.scoreFeaturesH2}</h2>
    <ul>
      {g.features.map(([key, title, body]) => (
        <li class={`feature feature--${key}`}>
          <div class="feature__demo" aria-hidden="true">
            {key === 'notes' && (
              <svg viewBox="0 0 120 60">
                <g class="staff"><path d="M4 14h112M4 24h112M4 34h112M4 44h112M4 54h112" /></g>
                <g class="n n1"><ellipse cx="28" cy="44" rx="6" ry="4.4" /><path d="M34 44V16" /></g>
                <g class="n n2"><ellipse cx="56" cy="34" rx="6" ry="4.4" /><path d="M62 34V6" /></g>
                <g class="n n3"><ellipse cx="84" cy="24" rx="6" ry="4.4" /><path d="M90 24V-4" /></g>
              </svg>
            )}
            {key === 'tab' && (
              <svg viewBox="0 0 120 60">
                <g class="staff"><path d="M4 8h112M4 18h112M4 28h112M4 38h112M4 48h112M4 58h112" /></g>
                <rect class="cursor" x="22" y="1" width="16" height="58" rx="3" />
                <text class="t t1" x="30" y="31">3</text>
                <text class="t t2" x="60" y="21">2</text>
                <text class="t t3" x="90" y="41">5</text>
              </svg>
            )}
            {key === 'export' && (
              <svg viewBox="0 0 120 60">
                <g class="doc"><rect x="40" y="6" width="40" height="48" rx="4" /><path d="M48 20h24M48 30h24M48 40h14" /></g>
                <g class="arrow"><path d="M60 -4v14M54 5l6 6 6-6" /></g>
                <g class="badges"><text x="18" y="34">PDF</text><text x="102" y="34">XML</text></g>
              </svg>
            )}
            {key === 'save' && (
              <svg viewBox="0 0 120 60">
                <rect class="bar-track" x="20" y="26" width="80" height="8" rx="4" />
                <rect class="bar-fill" x="20" y="26" width="80" height="8" rx="4" />
                <g class="check"><circle cx="60" cy="30" r="14" /><path d="m53 30 5 5 9-10" /></g>
              </svg>
            )}
          </div>
          <svg class="feature__icon" viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><Fragment set:html={icons[key]} /></svg>
          <h3>{title}</h3>
          <p>{body}</p>
        </li>
      ))}
    </ul>
    <a class="mobile-gate__cta mobile-gate__cta--ghost" href={tutorialsPath(locale)}>{g.tutorials}</a>
  </div>
</section>
