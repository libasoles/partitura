---
import { tutorialsPath, type Locale, strings } from '../i18n';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const s = strings(locale);
const g = s.mobileGate;
const ui = s.scoreUiStrings;
// The barre label is the first letter of the editor's own word for it, plus the fret ("C5").
const barreLabel = `${ui.barre.charAt(0)}5`;
// Lucide icons (stroke 2, 24 grid), one per feature. Keys are quoted: the Astro compiler reads a bare `export:` as a statement.
const icons: Record<string, string> = {
  'voices': '<path d="M9 18V5l12-2v13"/><circle cx="6" cy="18" r="3"/><circle cx="18" cy="16" r="3"/>',
  'slur': '<path d="M9 17H7A5 5 0 0 1 7 7h2"/><path d="M15 7h2a5 5 0 1 1 0 10h-2"/><path d="M8 12h8"/>',
  'triplet': '<path d="M2 10v3"/><path d="M6 6v11"/><path d="M10 3v18"/><path d="M14 8v7"/><path d="M18 5v13"/><path d="M22 10v3"/>',
  'barre': '<path d="M4 6h16M4 10h16M4 14h16M4 18h16"/>',
  'hairpin': '<path d="M3 12 21 5M3 12l18 7"/>',
  'export': '<path d="M12 15V3"/><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><path d="m7 10 5 5 5-5"/>',
};
---

<section class="mobile-gate" aria-labelledby="mobileGateTitle">
  <div class="mobile-gate__hero">
    <svg class="mobile-gate__logo" viewBox="20 -245 800 1035" fill="currentColor" aria-hidden="true"><g transform="rotate(-8 420 272.5)"><g transform="translate(-43 -87)"><g transform="translate(229 687) rotate(12) scale(0.88 1.14) translate(-229 -687)"><path d="M207 597 C172 556 152 525 143 473 L167 492 C119 447 109 387 120 326 L145 354 C128 262 146 178 196 119 C232 75 285 43 340 25 C356 21 362 28 359 46 C354 93 342 144 336 173 L312 214 L345 185 C370 265 381 336 368 397 C361 430 347 452 323 478 L359 450 C353 494 330 528 306 556 L339 535 C319 574 287 601 259 624 C240 644 231 664 229 687 C218 652 213 620 207 597Z"/><path d="M229 687 C195 536 201 375 255 208 C221 395 223 553 238 619 C233 648 230 671 229 687Z" style="fill: var(--paper)"/></g></g><path transform="translate(-8 0)" d="M229 687 L389 573 C485 493 583 458 679 498 C600 474 518 492 398 585 L229 698Z"/><ellipse cx="168" cy="657" rx="69.6" ry="30.9" transform="rotate(35 168 657)"/></g></svg>
    <p class="mobile-gate__name">{s.ui.siteName}</p>
    <h2 id="mobileGateTitle">{g.title}</h2>
    <p class="mobile-gate__lead">{g.body}</p>
    <span class="mobile-gate__cta-gap" aria-hidden="true">&nbsp;</span>
    <p class="mobile-gate__hint" aria-hidden="true">{g.scroll}</p>
  </div>

  <div class="mobile-gate__features">
    <h2>{s.scoreFeaturesH2}</h2>
    <ul>
      {g.features.map(([key, title, body]) => (
        <li class={`feature feature--${key}`}>
          <div class="feature__demo" aria-hidden="true">
            {key === 'voices' && (
              <svg viewBox="0 0 120 60">
                <g class="staff"><path d="M4 16h112M4 24h112M4 32h112M4 40h112M4 48h112" /></g>
                <g class="n v1 a1"><ellipse cx="30" cy="24" rx="5.5" ry="4" /><path d="M35.5 24V4" /></g>
                <g class="n v1 a2"><ellipse cx="60" cy="16" rx="5.5" ry="4" /><path d="M65.5 16V-4" /></g>
                <g class="n v1 a3"><ellipse cx="90" cy="24" rx="5.5" ry="4" /><path d="M95.5 24V4" /></g>
                <g class="n v2 b1"><ellipse cx="30" cy="40" rx="5.5" ry="4" /><path d="M24.5 40V58" /></g>
                <g class="n v2 b2"><path d="M58 33l4.5 5-4.5 4.5 4.5 5" /><path d="M62.5 47.5q-4.5-1.5-4.5 1.5" /></g>
                <g class="n v2 b3"><ellipse cx="90" cy="40" rx="5.5" ry="4" /><path d="M84.5 40V58" /></g>
              </svg>
            )}
            {key === 'slur' && (
              <svg viewBox="0 0 120 60">
                <g class="staff"><path d="M4 16h112M4 24h112M4 32h112M4 40h112M4 48h112" /></g>
                <path class="bar" d="M44 16V48" />
                <rect class="sel" x="19" y="12" width="50" height="38" rx="5" />
                <g class="m"><ellipse cx="10" cy="36" rx="4.5" ry="3.3" /><path d="M14.5 36V14" /></g>
                <g class="m"><ellipse cx="26" cy="36" rx="4.5" ry="3.3" /><path d="M30.5 36V14" /></g>
                <g class="m"><ellipse cx="62" cy="36" rx="4.5" ry="3.3" /><path d="M66.5 36V14" /></g>
                <path class="slur" pathLength="1" d="M26 42Q44 58 62 42" />
                <g class="menubox">
                  <rect class="menubox__bg" x="76" y="8" width="40" height="18" rx="4" />
                  <rect class="item i1" x="78" y="10" width="36" height="14" rx="3" />
                  <text class="label" x="82" y="20">{ui.link}</text>
                </g>
              </svg>
            )}
            {key === 'triplet' && (
              <svg viewBox="0 0 120 60">
                <g class="staff"><path d="M4 16h112M4 24h112M4 32h112M4 40h112M4 48h112" /></g>
                <rect class="sel" x="6" y="12" width="48" height="38" rx="5" />
                <g class="m"><ellipse cx="14" cy="38" rx="4.5" ry="3.3" /><path d="M18.5 38V16" /></g>
                <g class="m"><ellipse cx="29" cy="34" rx="4.5" ry="3.3" /><path d="M33.5 34V16" /></g>
                <g class="m"><ellipse cx="44" cy="38" rx="4.5" ry="3.3" /><path d="M48.5 38V16" /></g>
                <path class="beam" d="M18.5 16H48.5" />
                <g class="three"><path d="M18.5 8h10M38.5 8h10" /><text x="33.5" y="10">3</text></g>
                <g class="menubox">
                  <rect class="menubox__bg" x="66" y="8" width="50" height="18" rx="4" />
                  <rect class="item i2" x="68" y="10" width="46" height="14" rx="3" />
                  <text class="label" x="72" y="20">{ui.triplet}</text>
                </g>
              </svg>
            )}
            {key === 'barre' && (
              <svg viewBox="0 0 120 60">
                <g class="staff"><path d="M4 16h112M4 24h112M4 32h112M4 40h112M4 48h112M4 56h112" /></g>
                <g class="barre">
                  <text class="barre__label" x="26" y="9">{barreLabel}</text>
                  <path class="barre__line" d="M40 7H96V13" />
                </g>
                <text class="t" x="44" y="38">5</text>
                <text class="t" x="62" y="30">5</text>
                <text class="t" x="80" y="22">7</text>
                <text class="t" x="94" y="46">5</text>
              </svg>
            )}
            {key === 'hairpin' && (
              <svg viewBox="0 0 120 60">
                <g class="staff"><path d="M4 14h112M4 20h112M4 26h112M4 32h112M4 38h112" /></g>
                {[0, 1, 2, 3, 4, 5, 6, 7].map((i) => (
                  <g class="m"><ellipse cx={16 + i * 12} cy={i % 2 ? 23 : 29} rx="4" ry="3" /><path d={`M${20 + i * 12} ${i % 2 ? 23 : 29}V3`} /></g>
                ))}
                <path class="beam" d="M20 3H56M20 7H56M68 3H104M68 7H104" />
                <text class="dyn dyn1" x="9" y="56">p</text>
                <text class="dyn dyn2" x="111" y="56">f</text>
                <path class="hp" d="M20 52L100 46M20 52L100 58" />
              </svg>
            )}
            {key === 'export' && (
              <svg viewBox="0 0 120 60">
                <g class="doc"><rect x="40" y="6" width="40" height="48" rx="4" /><path d="M48 20h24M48 30h24M48 40h14" /></g>
                <g class="arrow"><path d="M60 -4v14M54 5l6 6 6-6" /></g>
                <g class="badges"><text x="18" y="34">PDF</text><text x="102" y="34">XML</text></g>
              </svg>
            )}
          </div>
          <svg class="feature__icon" viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><Fragment set:html={icons[key]} /></svg>
          <h3>{title}</h3>
          <p>{body}</p>
        </li>
      ))}
    </ul>
    <a class="mobile-gate__cta mobile-gate__cta--ghost" href={tutorialsPath(locale)}>{g.tutorials}</a>
  </div>
</section>
