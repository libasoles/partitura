---
import Base from '../layouts/Base.astro';
import { locales, pathFor, proPath, strings, type Locale } from '../i18n';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const s = strings(locale);
const t = s.pro;
const paths = Object.fromEntries(locales.map((l) => [l, proPath(l)])) as Record<Locale, string>;
// Argentina pays in ARS (the markup); everywhere else the script below swaps in the USD price. The number is sent to Analytics as the event value.
const plans = [
  { id: 'monthly', name: t.monthly, price: t.monthlyPrice, usd: t.monthlyPriceUsd, period: t.monthlyPeriod, value: 2000, valueUsd: 1 },
  { id: 'yearly', name: t.yearly, price: t.yearlyPrice, usd: t.yearlyPriceUsd, period: t.yearlyPeriod, value: 16000, valueUsd: 9 },
];
---

<Base locale={locale} title={t.metaTitle} description={t.metaDescription} paths={paths}>
  <main class="legal pro" data-pro>
    <h1 class="pro-title"><span>{t.h1}</span><svg class="pro-logo" viewBox="-120 -230 940 1100" fill="currentColor" role="img" aria-label="Logo con dos semicorcheas y pluma"><g transform="translate(-190 -30)"><path d="M221 679 C303 626 352 598 403 557 C500 478 583 453 682 496 C594 473 515 498 410 570 L230 692Z"/><ellipse cx="168" cy="657" rx="69.6" ry="30.9" transform="rotate(35 168 657)"/></g><g><path d="M221 679 C303 626 352 598 403 557 C500 478 583 453 682 496 C594 473 515 498 410 570 L230 692Z"/><ellipse cx="168" cy="657" rx="69.6" ry="30.9" transform="rotate(35 168 657)"/></g><g transform="translate(-110 -21) rotate(1 580 490)"><g transform="translate(580 0) scale(1.03 1) translate(-580 0)"><path d="M489 468.5 Q582 469.86 682 500.5 Q582 490.14 489 468.5Z"/><path d="M477 488.5 Q571 489.86 666 519.5 Q571 510.14 477 488.5Z"/></g></g><g transform="translate(-103 -43) rotate(-8 420 272.5)"><g transform="translate(-43 -87)"><g transform="translate(229 687) rotate(12) scale(0.88 1.14) translate(-229 -687)"><path d="M207 597 C172 556 152 525 143 473 L167 492 C119 447 109 387 120 326 L145 354 C128 262 146 178 196 119 C232 75 285 43 340 25 C356 21 362 28 359 46 C354 93 342 144 336 173 L312 214 L345 185 C370 265 381 336 368 397 C361 430 347 452 323 478 L359 450 C353 494 330 528 306 556 L339 535 C319 574 287 601 259 624 C240 644 231 664 229 687 C218 652 213 620 207 597Z"/><path d="M229 687 C195 536 201 375 255 208 C221 395 223 553 238 619 C233 648 230 671 229 687Z" style="fill: var(--paper)"/></g></g></g></svg></h1>
    <p class="pro-lead">{t.lead}</p>

    <section>
      <h2>{t.featuresTitle}</h2>
      <ul class="pro-features">
        {t.features.map(([name, body]) => (
          <li>
            <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 6 9 17l-5-5"/></svg>
            <span><strong>{name}.</strong> {body}</span>
          </li>
        ))}
      </ul>
    </section>

    <section data-pro-plans>
      <h2>{t.plansTitle}</h2>
      <div class="pro-plans">
        {plans.map((plan) => (
          <div class="pro-plan">
            <h3>{plan.name}</h3>
            <p class="pro-price"><span data-usd={plan.usd}>{plan.price}</span> {plan.period}</p>
            <button type="button" class="pro-choose" data-plan={plan.id} data-value={plan.value} data-value-usd={plan.valueUsd}>{t.choose}</button>
          </div>
        ))}
      </div>
      <p class="legal-updated" data-usd={t.currencyUsd}>{t.currency}</p>
    </section>

    <section class="pro-thanks" data-pro-thanks role="status" aria-live="polite" tabindex="-1" hidden>
      <svg class="pro-thanks-icon" viewBox="0 0 24 24" width="40" height="40" fill="currentColor" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M2 9.5a5.5 5.5 0 0 1 9.591-3.676.56.56 0 0 0 .818 0A5.49 5.49 0 0 1 22 9.5c0 2.29-1.5 4-3 5.5l-5.492 5.313a2 2 0 0 1-3 .019L5 15c-1.5-1.5-3-3.2-3-5.5"/></svg>
      <h2>{t.thanksTitle}</h2>
      <p>{t.thanksBody}</p>
      <p>{t.thanksFree}</p>
    </section>

    <p><a href={pathFor(locale)}>← {t.back}</a></p>
  </main>

  <script is:inline>
    (function () {
      var root = document.querySelector('[data-pro]');
      if (!root) return;
      function track(name, params) {
        try { if (window.gtag) gtag('event', name, params); } catch (e) {}
      }
      // Funnel: pro_menu_click (menu) → pro_page_view (this page) → pro_plan_click (a plan button) → pro_waitlist_shown (the notice).
      track('pro_page_view');
      var plans = root.querySelector('[data-pro-plans]');
      // Outside Argentina the prices are in dollars. The time zone is the signal (no request to a geolocation service).
      var zone = '';
      try { zone = Intl.DateTimeFormat().resolvedOptions().timeZone || ''; } catch (e) {}
      var usd = !/^America\/(Argentina\/|Buenos_Aires$|Cordoba$|Mendoza$|Jujuy$|Catamarca$|Rosario$)/.test(zone);
      if (usd) plans.querySelectorAll('[data-usd]').forEach(function (el) { el.textContent = el.getAttribute('data-usd'); });
      var thanks = root.querySelector('[data-pro-thanks]');
      root.addEventListener('click', function (event) {
        var btn = event.target.closest('.pro-choose');
        if (!btn) return;
        var plan = btn.getAttribute('data-plan');
        track('pro_plan_click', { plan: plan, value: Number(btn.getAttribute(usd ? 'data-value-usd' : 'data-value')), currency: usd ? 'USD' : 'ARS' });
        plans.hidden = true;
        thanks.hidden = false;
        thanks.focus();
        track('pro_waitlist_shown', { plan: plan });
      });
    })();
  </script>
</Base>
