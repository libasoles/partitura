---
import Base from '../layouts/Base.astro';
import { renderEmptyStaff } from '../lib/staff.js';
import { renderDemo } from '../lib/published-demo.js';
import { pathFor, strings, locales, tutorialsPath, type Locale } from '../i18n';
import MobileGate from './MobileGate.astro';
import WelcomeBanner from './WelcomeBanner.astro';
import EditorSection from './EditorSection.astro';
import { DEMOS, demoPath } from '../client/demos.js';
import '../styles/editor.css';
import '../styles/mobile-gate.css';

interface Props {
  locale: Locale;
  demo?: (typeof DEMOS)[number];
}

const { locale, demo } = Astro.props;
const s = strings(locale);
// The staff the editor starts from, drawn now so the first paint (and anything that does not run JS) already has it.
const demoSources = import.meta.glob<string>('/public/demos/*.musicxml', { query: '?raw', import: 'default' });
const published = demo ? await renderDemo(await demoSources[`/public${decodeURIComponent(demo.url)}`]()) : undefined;
const staff = published?.svg ?? await renderEmptyStaff(undefined, undefined, { grandStaff: true });
const paths = Object.fromEntries(locales.map((l) => [l, demo ? demoPath(l, demo) : pathFor(l)])) as Record<Locale, string>;
const title = demo ? `${demo.title} — ${demo.author} | ${s.ui.siteName}` : s.scorePageTitle;
const descriptions = demo && {
  es: 'Descargá la partitura en PDF, escuchala y mirá sus intervalos. Editor de partituras online, gratis y sin registro.',
  en: 'Download the sheet music as a PDF, listen to it and see its intervals. Free online sheet music editor, no sign-up.',
  pt: 'Baixe a partitura em PDF, ouça e veja seus intervalos. Editor de partituras online, grátis e sem cadastro.',
};
---

<Base locale={locale} title={title} description={descriptions ? descriptions[locale] : s.scoreMetaDescription} author={demo?.author} ogImage={demo && `/demos/${demo.id}/og.png`} hideWelcomeBanner={Boolean(demo)} paths={paths} editor>
  <main class="score-page" id="top">
    {demo && <div class="sr-only"><h1>{demo.title} — {demo.author}</h1><p>{descriptions?.[locale]}</p></div>}
    <div id="scoreDropzone" class="score-dropzone" role="status" aria-live="polite" hidden>
      <strong data-drop-accepted>{s.scoreUiStrings.dropAccepted}</strong>
      <strong data-drop-rejected>{s.scoreUiStrings.dropRejected}</strong>
      <span>MusicXML (.musicxml, .xml) · MIDI (.mid, .midi)</span>
    </div>
    <WelcomeBanner locale={locale} />

    {!demo && <MobileGate locale={locale} />}

    <EditorSection locale={locale} demo={demo} staff={staff} />

    {demo && <button id="mobilePlay" class="mobile-play" type="button" aria-pressed="false"><svg class="mobile-play__play" viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polygon points="6 3 20 12 6 21 6 3"/></svg><svg class="mobile-play__pause" viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="14" y="3" width="5" height="18" rx="1"/><rect x="5" y="3" width="5" height="18" rx="1"/></svg><span>{s.scoreUiStrings.play}</span></button>}
    {demo && <button id="mobilePdf" class="mobile-pdf" type="button"><svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 15V3"/><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><path d="m7 10 5 5 5-5"/></svg>{s.ui.downloadPdf}</button>}
    {demo && published && <script id="demoScore" type="application/json" set:html={JSON.stringify({ id: demo.id, score: published.score }).replace(/</g, '\\u003c')} />}
    <script>
      import '../client/main.js';
    </script>
  </main>
</Base>
