---
import Base from '../layouts/Base.astro';
import { renderEmptyStaff } from '../lib/staff.js';
import { renderDemo } from '../lib/published-demo.js';
import { pathFor, strings, locales, type Locale } from '../i18n';
import MobileGate from './MobileGate.astro';
import WelcomeBanner from './WelcomeBanner.astro';
import { DEMOS, demoPath } from '../client/demos.js';
import '../styles/editor.css';
import '../styles/mobile-gate.css';

interface Props {
  locale: Locale;
  demo?: (typeof DEMOS)[number];
}

const { locale, demo } = Astro.props;
const s = strings(locale);
// The staff the editor starts from, drawn now so the first paint (and anything that does not run JS) already has it.
const demoSources = import.meta.glob<string>('/public/demos/*.musicxml', { query: '?raw', import: 'default' });
const published = demo ? await renderDemo(await demoSources[`/public${decodeURIComponent(demo.url)}`]()) : undefined;
const staff = published?.svg ?? await renderEmptyStaff(undefined, undefined, { grandStaff: true });
const paths = Object.fromEntries(locales.map((l) => [l, demo ? demoPath(l, demo) : pathFor(l)])) as Record<Locale, string>;
const title = demo ? `${demo.title} — ${demo.author} | ${s.ui.siteName}` : s.scorePageTitle;
const descriptions = demo && {
  es: `${demo.title}, de ${demo.author}. Partitura para tres voces con reproducción e intervalos.`,
  en: `${demo.title}, by ${demo.author}. Three-voice sheet music with playback and intervals.`,
  pt: `${demo.title}, de ${demo.author}. Partitura para três vozes com reprodução e intervalos.`,
};
// The editor reads these at start-up; the toast bundle reads the same block.
const clientStrings = Object.fromEntries([
  ...Object.entries(s.scoreUiStrings),
  ...Object.entries(s).filter(([key]) => key.startsWith('toast')),
]);
---

<Base locale={locale} title={title} description={descriptions ? descriptions[locale] : s.scoreMetaDescription} author={demo?.author} hideWelcomeBanner={Boolean(demo)} paths={paths} editor>
  <main class="score-page" id="top">
    {demo && <div class="sr-only"><h1>{demo.title} — {demo.author}</h1><p>{descriptions?.[locale]}</p></div>}
    <div id="scoreDropzone" class="score-dropzone" role="status" aria-live="polite" hidden>
      <strong data-drop-accepted>{s.scoreUiStrings.dropAccepted}</strong>
      <strong data-drop-rejected>{s.scoreUiStrings.dropRejected}</strong>
      <span>MusicXML (.musicxml, .xml) · MIDI (.mid, .midi)</span>
    </div>
    <WelcomeBanner locale={locale} />

    {!demo && <MobileGate locale={locale} />}

    <section id="editor" class="score-editor" aria-label={s.scoreLabel} data-demo-id={demo?.id}>
      <div class="score-workspace">
        <div class="score-main">
          <div id="scoreTabs" class="score-doc-tabs" role="group" aria-label={s.scoreTabs} data-default-title={s.scoreH1}>
            <!-- The default document's tab, so "+" does not jump when the editor script swaps in the saved tabs. -->
            <div class="score-doc-tab is-active" aria-current="true"><input type="text" class="score-doc-tab-input" value={s.scoreH1} aria-label={s.scoreUiStrings.titleLabel} /></div>
            <button id="scoreNewTab" class="score-new-tab tooltip" type="button" data-icon="plus" aria-label={s.scoreNewTab} data-tooltip={s.scoreNewTab}></button>
          </div>
          <div class="score-toolbar" role="toolbar" aria-label={s.scoreToolbar}>
            <div id="scorePalette" class="score-palette"></div>
          </div>
          <p id="scoreStatus" class="score-status" role="status" aria-live="polite"></p>
          <section class="score-sheet" aria-label={s.scoreLabel}>
            <p class="score-author"><input id="scoreAuthor" type="text" placeholder={s.scoreAuthorPlaceholder} aria-label={s.scoreAuthorLabel} value={demo?.author} /></p>
            <div class="score-title"><input id="scoreTitle" type="text" aria-label={s.scoreTitleLabel} value={demo?.title ?? s.scoreH1} /></div>
            <div id="scoreStage" class="score-stage" tabindex="0" aria-busy={demo ? 'false' : 'true'} data-prerendered={demo ? 'true' : undefined} aria-label={s.scoreLabel} set:html={staff} />
          </section>
        </div>
        <div class="score-side-track">
          <aside class="score-side">
            <div id="scoreBarlines" class="score-barlines" role="toolbar" aria-label={s.scoreBarlines} aria-orientation="vertical"></div>
            <button id="scoreClear" class="score-download tooltip" type="button" data-icon="trash" aria-label={s.scoreClear} data-tooltip={s.scoreClear} hidden={Boolean(demo)}></button>
            <button id="scoreDuplicate" class="score-download tooltip" type="button" data-icon="copy" aria-label={s.scoreDuplicate} data-tooltip={s.scoreDuplicate} hidden></button>
          </aside>
        </div>
      </div>
      <div class="score-rows">
        <button id="scoreAddRow" class="score-tool" type="button" aria-label={s.scoreAddRow} title={s.scoreAddRow}></button>
        <button id="scoreRemoveRow" class="score-tool" type="button" aria-label={s.scoreRemoveRow} title={s.scoreRemoveRow} hidden></button>
      </div>
      <noscript><p class="noscript">{s.ui.noscript}</p></noscript>
    </section>

    <p id="saveStatus" class="autosave-status" role="status" aria-live="polite" data-saving={s.saveSaving} data-saved={s.saveSaved}></p>

    <script id="scoreStrings" type="application/json" set:html={JSON.stringify(clientStrings).replace(/</g, '\\u003c')} />
    {demo && published && <script id="demoScore" type="application/json" set:html={JSON.stringify({ id: demo.id, score: published.score }).replace(/</g, '\\u003c')} />}
    <script>
      import '../client/main.js';
    </script>
  </main>
</Base>
