{
  "name": "partitura",
  "private": true,
  "type": "module",
  "description": "Editor de partituras online, renderizado en el servidor para SEO",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "check": "astro check",
    "test": "node --test test/*.test.mjs",
    "test:browser": "playwright test",
    "predev": "node scripts/vendor.mjs",
    "prebuild": "node scripts/build-package.mjs && node scripts/vendor.mjs",
    "postbuild": "node scripts/compress.mjs",
    "serve": "node scripts/serve.mjs",
    "lighthouse": "node scripts/lighthouse.mjs",
    "og": "node scripts/og.mjs",
    "prepare": "node scripts/build-package.mjs"
  },
  "dependencies": {
    "@radix-ui/react-alert-dialog": "^1.2.1",
    "@radix-ui/react-toast": "^1.3.1",
    "esbuild": "^0.28.2",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "verovio": "6.4.0"
  },
  "devDependencies": {
    "@astrojs/check": "latest",
    "@astrojs/sitemap": "latest",
    "@fontsource-variable/montserrat": "^5.3.0",
    "@playwright/test": "^1.64.1",
    "astro": "^7.4.1",
    "el-silbador": "github:libasoles/el-silbador#a535d7dcb3b625ad478e90a2f8ab08ba431c3bc1",
    "guitar-chords": "github:libasoles/guitar-chords#77e1da59bf3192707f0468f2c7dd0be727e5dda3",
    "lighthouse": "^13.6.0",
    "typescript": "^5.9.0"
  },
  "version": "0.1.0",
  "exports": {
    "./editor": "./src/client/runtime.js",
    "./build": "./scripts/build-editor.mjs",
    "./model": {
      "import": "./src/client/score-model.js",
      "require": "./lib/model.cjs"
    },
    "./fingering": {
      "import": "./src/client/score-fingering.js",
      "require": "./lib/fingering.cjs"
    },
    "./io": {
      "import": "./src/client/score-io.js",
      "require": "./lib/io.cjs"
    },
    "./staff": "./src/lib/staff.js"
  },
  "files": [
    "src/client",
    "src/vendor",
    "scripts/build-editor.mjs",
    "scripts/build-package.mjs",
    "scripts/lib/editor-vendor.mjs",
    "scripts/lib/chords-data.mjs",
    "lib",
    "public/vendor/jspdf.umd.min.js",
    "public/vendor/audio",
    "src/lib/staff.js",
    "docs/shared-editor.md"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/libasoles/partitura.git"
  }
}
